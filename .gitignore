# Runtime data: SQLite jobs + uploads/results (keep .gitkeep layout)
/data/*
!/data/uploads/
!/data/results/
/data/uploads/*
!/data/uploads/.gitkeep
/data/results/*
!/data/results/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# In-repo Whisper cache if ATM_WHISPER_DOWNLOAD_ROOT points here
/models/
/whisper-cache/

# Media dropped in the repo root while testing uploads
/*.wav
/*.mp3
/*.m4a
/*.flac
/*.ogg
